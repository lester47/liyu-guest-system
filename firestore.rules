rules_version = '2';

// 鯉魚國小來賓通報系統 Firestore 安全規則
// 貼到 Firebase 主控台 → Firestore Database → 規則 → 發布
service cloud.firestore {
  match /databases/{database}/documents {

    // ★ 第一次使用前必改：系統管理者（最高權限）的電子郵件，全部小寫
    //   只有這個帳號能新增或移除「管理者」，也無法從網站上被移除。
    //   要換人時，改這裡並重新發布規則即可。
    function ownerEmail() { return 'lester47@gmail.com'; }

    // 工作人員只能用 Google 或「帳號密碼」登入，而且電子郵件必須已驗證
    function isStaffLogin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'password']
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function staffPath() { return /databases/$(database)/documents/settings/staff; }
    function staffList() { return get(staffPath()).data; }

    // 三層權限：系統管理者 > 管理者 > 工作人員
    function isOwner() { return isStaffLogin() && myEmail() == ownerEmail(); }
    function isAdmin() {
      return isOwner() || (isStaffLogin() && exists(staffPath()) && myEmail() in staffList().admins);
    }
    function isStaff() {
      return isAdmin() || (isStaffLogin() && exists(staffPath()) && myEmail() in staffList().emails);
    }

    // 來賓自助報到：匿名登入，只能新增一筆「待確認」資料，欄位與長度都受限
    function validSelf(id) {
      let d = request.resource.data;
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && id == request.auth.uid                       // 每次匿名登入只能送一筆
        && d.keys().hasOnly(['title', 'name', 'cat', 'first', 'status', 'source', 'createdAt', 'arrivedAt'])
        && d.status == 'review' && d.source == 'self' && d.first == false
        && d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.title is string && d.title.size() <= 60
        && d.cat in ['長官', '貴賓', '家長', '其他']   // 若改了 js/config.js 的 CATS，這裡也要一起改
        && d.createdAt is number && d.arrivedAt is number;
    }

    // 帳號與權限名單 {owner, admins, emails}
    match /settings/staff {
      allow get: if isStaff();
      // 第一次使用：系統管理者登入時建立空白名單
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['owner', 'admins', 'emails'])
        && request.resource.data.owner == ownerEmail()
        && request.resource.data.admins == []
        && request.resource.data.emails == [];
      // 系統管理者：可調整管理者與工作人員
      // 管理者：只能調整工作人員，不能動管理者名單
      allow update: if request.resource.data.keys().hasOnly(['owner', 'admins', 'emails'])
        && request.resource.data.owner == ownerEmail()
        && request.resource.data.admins is list
        && request.resource.data.emails is list
        && (isOwner() || (isAdmin() && request.resource.data.admins == resource.data.admins));
      allow delete: if false;
    }

    // 活動名稱與給司儀的提醒：大家都能讀（來賓頁要顯示活動名稱），只有管理者能改
    match /settings/event {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 報到序號計數器 {n}：每場活動從 1 開始
    //   工作人員取號時只能往上加；管理者結案或切換活動時可以重設
    match /settings/counter {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n is int
        && (isAdmin() || (isStaff() && request.resource.data.n > resource.data.n));
      allow delete: if false;
    }

    // 來賓名單
    //   管理者：匯入、編輯、刪除、清空
    //   工作人員：報到、確認、移動卡片；只能新增臨時來賓，只能刪除臨時來賓與自助報到
    //   來賓：只能新增自己的一筆待確認報到，讀不到任何資料
    match /guests/{id} {
      // 來賓（匿名）只能讀自己送出的那一筆，用來在手機上看到報到序號
      allow get: if isStaff() || (request.auth != null && request.auth.uid == id);
      allow list, update: if isStaff();
      allow create: if isAdmin()
        || (isStaff() && request.resource.data.source == 'walkin')
        || validSelf(id);
      allow delete: if isAdmin()
        || (isStaff() && resource.data.source in ['walkin', 'self']);
    }

    // 已結案的活動紀錄（2026-11 新增）
    //   archives/{id}：摘要；archives/{id}/rows/all：完整名單
    //   工作人員可看、可匯出；管理者可結案（新增）；只有系統管理者能刪除；封存後不能修改
    match /archives/{id} {
      allow read: if isStaff();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['event', 'closedAt', 'closedBy', 'count', 'arrived', 'introduced'])
        && request.resource.data.event is string && request.resource.data.event.size() <= 60
        && request.resource.data.closedAt is number
        && request.resource.data.count is int && request.resource.data.count <= 2000;
      allow update: if false;
      allow delete: if isOwner();

      match /rows/{rid} {
        allow read: if isStaff();
        allow create: if isAdmin() && rid == 'all'
          && request.resource.data.keys().hasOnly(['guests'])
          && request.resource.data.guests is list
          && request.resource.data.guests.size() <= 2000;
        allow update: if false;
        allow delete: if isOwner();
      }
    }

    // 申請使用權限：已驗證的 Google／帳號密碼使用者可送出自己的一筆申請
    //   只有系統管理者能看清單、核准（刪除申請）；申請人只能看自己的那一筆
    match /requests/{uid} {
      allow get: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow list, delete: if isOwner();
      allow create: if isStaffLogin() && uid == request.auth.uid && !isStaff()
        && request.resource.data.keys().hasOnly(['email', 'name', 'createdAt'])
        && request.resource.data.email == myEmail()
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.createdAt is number;
    }

    // 其他路徑一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
